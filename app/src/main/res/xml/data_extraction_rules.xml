<?xml version="1.0" encoding="utf-8"?>
<!-- The personal vault is encrypted with a device-bound Keystore key that is never backed up:
     restored vault files could not be decrypted, so they are excluded from backup and transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="remote/" />
        <exclude domain="file" path="im/" />
        <exclude domain="file" path="shell/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="vault/" />
        <exclude domain="file" path="remote/" />
        <exclude domain="file" path="im/" />
        <exclude domain="file" path="shell/" />
    </device-transfer>
</data-extraction-rules>
